# Required: Bot User OAuth Token (OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode (local development): App-Level Token with the connections:write scope
SLACK_APP_TOKEN=xapp-...
# HTTP mode (production): Signing Secret (Basic Information page)
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to run /osada-admin
OSADA_ADMINS=U01234567
# Postgres URL; leave empty to use a local PGlite database in ./.pglite
DATABASE_URL=
# Public base URL Slack can fetch map images from (needed for the map in App Home and the digest)
PUBLIC_URL=
# Secret for signing map links (defaults to the signing secret or bot token)
MAP_SECRET=
# Bearer token for POST /cron/tick (Cloud Scheduler); leave empty to disable the endpoint
CRON_SECRET=
PORT=3000
